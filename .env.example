NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://ligimed:ligimed_local_only@127.0.0.1:5432/ligimed
REDIS_URL=redis://127.0.0.1:6379
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
SESSION_COOKIE_NAME=ligimed_session
SESSION_TTL_SECONDS=28800
# Generate separate values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=replace-with-an-independently-generated-secret
CSRF_SECRET=replace-with-a-different-independently-generated-secret
OTP_PROVIDER=development
# Public OAuth client ID; use the same value for API and browser apps.
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=sandbox
LOG_LEVEL=debug

# Browser-exposed configuration. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-only origin used by the Pharmacy app's same-origin authentication transport.
API_INTERNAL_URL=http://127.0.0.1:4000
